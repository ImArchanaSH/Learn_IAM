---
// Draws an icon from the Lucide set (https://lucide.dev/icons) by name, e.g. <Icon name="book-open" />.
// LinkedIn and GitHub logos are kept here because Lucide doesn't include brand logos.
import fs from 'node:fs';
import path from 'node:path';

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls = '' } = Astro.props;

const brands: Record<string, string> = {
  linkedin: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.77 2.5 4.77 5.75v5.7h-4v-5.05c0-1.2-.02-2.75-1.7-2.75-1.7 0-1.95 1.3-1.95 2.66v5.14h-3.75v-11Z"/></svg>',
  github: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>',
};

let svg = brands[name];
if (!svg) {
  const file = path.join(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`);
  svg = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : fs.readFileSync(file.replace(name, 'circle'), 'utf8');
}
// Only change the outer <svg> tag (inner shapes keep their own width/height).
svg = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<svg[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|class)="[^"]*"/g, '')
      .replace('<svg', `<svg width="${size}" height="${size}" class="icon ${cls}" aria-hidden="true" focusable="false"`),
  );
---
<Fragment set:html={svg} />
